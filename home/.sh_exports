# History — deliberately NOT exported: an exported HISTFILE would leak into
# bash subshells, which would then rewrite zsh's history file in bash format
# (no timestamps, clobbering shared history). Shell history vars are
# per-shell state, not environment.
HISTFILE=$HOME/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000

# Preferred editor for local and remote sessions
export EDITOR='vim'

# Prefer US English and use UTF-8
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# Compilation flags
if [[ "$(uname -m)" == "arm64" ]]; then
  export ARCHFLAGS="-arch arm64"
else
  export ARCHFLAGS="-arch x86_64"
fi

# Don't clear the screen after quitting a manual page
export MANPAGER="less -X"

# Make less the default pager (plain string — this file must stay POSIX sh
# compatible, no arrays). Options:
#   --quit-if-one-screen  behave like cat for short output
#   --no-init             do not clear the screen first
#   --ignore-case         smartcase search (case-sensitive only if mixed)
#   --chop-long-lines     do not wrap long lines
#   --RAW-CONTROL-CHARS   allow ANSI colors, no other escapes
#   --quiet --dumb        no bell, no dumb-terminal complaints
export LESS="--quit-if-one-screen --no-init --ignore-case --chop-long-lines --RAW-CONTROL-CHARS --quiet --dumb"
export PAGER='less'

export HOMEBREW_CASK_OPTS="--appdir=/Applications"

export GOPATH=$HOME/Code/go

export ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
export ANDROID_AVD_HOME=$HOME/.android/avd
