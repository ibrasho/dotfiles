# Enable aliases to be sudo’ed
alias sudo="sudo "

alias dc="docker-compose"

# Shortcuts
alias g="git"
alias vi="vim"

# mv, rm, cp, gunzip
alias mv="mv -v"
alias rm="rm -I -v"
alias cp="cp -v"

# Be nice
alias htop='sudo htop'
alias hosts='sudo $EDITOR /etc/hosts'

# Modern CLI tools

# Use eza (modern ls) if available, otherwise fallback to ls/gls
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza --icons --group-directories-first -l'
  alias la='eza --icons --group-directories-first -la'
  alias lt='eza --icons --group-directories-first --tree'
  alias lta='eza --icons --group-directories-first --tree -a'
else
  # Fallback to traditional ls
  hash gls >/dev/null 2>&1 || alias gls="ls"
  if gls --color > /dev/null 2>&1; then
    colorflag="--color"
  else
    colorflag="-G"
  fi
  export CLICOLOR_FORCE=1
  alias ls='ls -AFh ${colorflag}'
fi

# Use bat (better cat) if available
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
  alias less='bat --paging=always'
  alias bathelp='bat --plain --language=help'
  # zsh only: in bash this would shadow the `help` builtin
  if [ -n "$ZSH_VERSION" ]; then
    help() {
      "$@" --help 2>&1 | bathelp
    }
  fi
fi

# Note: fd is installed but NOT aliased to find — fd's CLI is incompatible
# with find's flags (`find . -name x` would break). Use `fd` directly.

# IP addresses
alias localip="ipconfig getifaddr en0"
alias myip="ifconfig | grep 'inet ' | grep -v 127.0.0.1 | awk '{print \$2}'"

# Copy my public key to the pasteboard
alias pubkey="pbcopy < $HOME/.ssh/ibrasho.pub && printf '=> Public key copied to pasteboard.\n'"

# Flush DNS cache
alias flushdns="dscacheutil -flushcache"

# Git aliases
# More Git tips http://firstaidgit.io/
alias gp="git push origin HEAD"
alias ga="git add"
alias gap='git add -p'
alias gs='git status'
alias gd='git diff'
alias gdc='git diff --cached'
alias gco='git checkout'
alias gl='git log'
alias gr='git restore'
alias grs='git restore --staged'

# View HTTP traffic
alias sniff="sudo ngrep -W byline -d 'en0' -t '^(GET|POST) ' 'tcp and port 80'"
alias httpdump="sudo tcpdump -i en0 -n -s 0 -w - | grep -a -o -E \"Host\: .*|GET \/.*\""

# Disc utils
alias diskspace_report="df -P -kHl"
alias free_diskspace_report="diskspace_report"

# File size (explicitly BSD stat: coreutils gnubin shadows `stat` with GNU
# stat, where -f means "filesystem mode" and this would break)
alias fs="/usr/bin/stat -f \"%z bytes\""

# Empty the Trash on all mounted volumes and the main HDD.
alias emptytrash="sudo rm -rfv /Volumes/*/.Trashes; rm -rf $HOME/.Trash"

# Shell config editing/reloading — test the RUNNING shell ($ZSH_VERSION),
# not $SHELL (the login shell), which stays "zsh" even inside bash.
if [ -n "$ZSH_VERSION" ]; then
	alias zshrc="${EDITOR} $HOME/.zshrc"
	alias reload="source $HOME/.zshrc && echo 'Shell config reloaded from $HOME/.zshrc'"
elif [ -n "$BASH_VERSION" ]; then
	alias reload="source $HOME/.bash_profile && echo 'Shell config reloaded from $HOME/.bash_profile'"
fi

# zsh.local config
alias localrc="if [ -f $HOME/.zsh.local ]; then ${EDITOR} $HOME/.zsh.local; fi"
