# Explicitly configured $PATH
# PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# PATH="/usr/local/sbin:$PATH"
# PATH="/usr/local:$PATH"

if command -v brew >/dev/null 2>&1; then
  HOMEBREW_PREFIX="$(brew --prefix)"
  PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
  MANPATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnuman:$MANPATH"
fi

PATH="$HOME/bin:$PATH"

# Global Node.js packages from Herd NVM
PATH="$HOME/.node/bin:$PATH"

# Global Composer packages
PATH="$HOME/.composer/vendor/bin:$PATH"

# Security Note: Local project binaries (./node_modules/.bin and ./vendor/bin)
# are NOT added to PATH by default to prevent command injection vulnerabilities.
# Use one of these safer alternatives:
#   - npx <command>           # For Node.js binaries
#   - composer exec <command> # For PHP binaries
#   - direnv                  # For trusted project directories only

# PATH="$HOME/.local/bin:$PATH"

# Note: Ruby, Node.js, Python versions are now managed by mise
# Run: mise use -g node@lts ruby@latest python@latest

# Export
export PATH MANPATH
