# Global gitignore (core.excludesfile) — OS and editor junk ONLY.
# Project-type patterns (node_modules, *.log, build artifacts, ...) belong in
# each project's own .gitignore: keeping them here can silently hide files
# that a work repo legitimately tracks.

# Git credential file
.gitconfig.local

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Desktop.ini
Thumbs.db
ehthumbs.db

# Editor leftovers
*~
.idea

# Claude Code machine-local settings
.claude/settings.local.json
