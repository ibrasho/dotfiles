[core]
	editor = vim
	abbrev = 12
	excludesfile = ~/.gitignore
	autocrlf = input
	mergeoptions = --no-edit
	ignorecase = false
	pager = delta

# A good list of alises http://haacked.com/archive/2014/07/28/github-flow-aliases/
[alias]
	# Staging
	a = add
	aa = add --all

	# Branch
	br = branch
	branch-name = rev-parse --abbrev-ref HEAD
	# Resolve the remote's default branch (main/master) instead of hardcoding
	default-branch = "!f() { b=$(git symbolic-ref -q --short refs/remotes/origin/HEAD); b=${b#origin/}; echo ${b:-main}; }; f"
	branch-diff = "!git diff $(git default-branch)...HEAD"
	branch-files = "!git diff $(git default-branch)...HEAD --name-status | sed '/^D/d ; s/^.\\s\\+//'"

	# Commit
	c = commit -s
	ca = commit -as
	ci = commit -s
	cal = !git add -A && git commit -s              # Commit all changes
	cam = commit -asm
	cne = commit --no-edit -s
	amend = commit -s --amend
	amend-all = !git add --all && git commit -s --amend --reuse-message=HEAD

	unstage = reset
	uncommit = reset --soft HEAD^
	staged = diff --cached

	# Clone
	cl = clone
	sclone = clone --depth=1

	# Checkout
	co = checkout
	cb = checkout -b

	# Cherry-pick
	cp = cherry-pick

	# Diff
	d = diff
	dd = diff --no-ext-diff                      # Bypass difftastic (delta renders instead)
	dw = diff --no-ext-diff --color-words
	dc = diff --cached
	df = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# Merge
	m = merge

	# Pull
	pl = pull
	plom = "!git pull origin $(git default-branch)"
	plum = "!git pull upstream $(git default-branch)"
	preb = "!git fetch upstream && git rebase upstream/$(git default-branch)"

	# Push
	p = push
	pom = "!git push origin $(git default-branch)"
	poh = push origin head

	# Stash
	st = stash
	stp = stash pop

	# Status/Logging
	s = status
	ss = status -sb
	hist = log --graph --pretty=custom           # Show custom graph
	l = log --pretty=custom                      # Show custom log
	ll = log --stat --abbrev-commit
	lc = shortlog --summary --numbered           # List contributors

	# Reset
	# (unstage/uncommit are defined in the Commit section above; an alias
	# named `reset` would be silently ignored — git aliases can't shadow
	# builtin commands.)
	undo = reset --soft HEAD~1                   # Undo last commit (affects HEAD only)

	# Remote
	r = remote -v

	# Submodules
	subpl = submodule update --init --recursive

	# Misc
	publish = "!git push --set-upstream origin $(git branch-name)"

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	# Find commits by source code

	cc = "!f() { \
		git log --pretty=custom --decorate --date=short -S\"$1\"; \
	}; f"

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	# Credit an author on the latest commit

	credit = "!f() { \
		if [ -n \"$1\" ] && [ -n \"$2\" ]; then \
			git commit --amend --author \"$1 <$2>\" -C HEAD; \
		fi \
	}; f"

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	# List remote branches

	lrb = "!f() { \
		remote="${1:-origin}"; \
		git ls-remote --heads "$remote"; \
	}; f"

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

	# Remove the tag with the specified tag name if
	# exists and tag the latest commit with that name

	retag = "!f() { \
		git tag -d "$1" &> /dev/null; \
		git tag $1; \
	}; f"

	# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# So much color
[color]
	ui = true

[color "branch"]
	current = green bold
	local = green
	remote = yellow

[color "diff"]
	frag = magenta bold
	meta = 11
	new = green bold
	old = red bold
	func = 146 bold
	commit = yellow bold
	whitespace = red reverse

[pretty]
	custom = "%C(magenta)%h%C(red)%d %C(yellow)%ar %C(green)%s %C(yellow)(%an)"
	#                     │        │            │            │             └─ author name
	#                     │        │            │            └─ message
	#                     │        │            └─ date (relative)
	#                     │        └─ decorations (branch, heads or tags)
	#                     └─ hash (abbreviated)

[help]
	# Suggest the corrected command and ask before running it
	# (a numeric value would AUTO-RUN the guess after N deciseconds)
	autocorrect = prompt

# (git:// protocol was disabled by GitHub in 2022 — shorthands use https/ssh)
[url "git@github.com:"]
	insteadOf = "gh:"
	pushInsteadOf = "github:"
	# Push over SSH (1Password agent) even in repos cloned via HTTPS;
	# fetches keep using HTTPS, so read-only clones stay tokenless.
	pushInsteadOf = "https://github.com/"

[url "https://github.com/"]
	insteadOf = "github:"

[url "git@gist.github.com:"]
	insteadOf = "gst:"
	pushInsteadOf = "gist:"

[url "https://gist.github.com/"]
	insteadOf = "gist:"

# Push easily http://stackoverflow.com/a/23918418/89484
[push]
    # Make `git push` automatically push relevant
    # annotated tags when pushing branches out
    followTags = true
    default = current

# Use separate file for username / github token / etc
[include]
    path = ~/.gitconfig.local

[filter "lfs"]
    clean = git lfs clean %f
    smudge = git lfs smudge %f
    required = true

[fetch]
    prune = true

[commit]
    gpgsign = true

# User configuration is loaded from ~/.gitconfig.local
# See README.md for template

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    # Without this, git verifies nothing and reports every signed commit as
    # "No signature" — indistinguishable from a genuinely unsigned one.
    # The file holds the key material and stays out of this repo.
    allowedSignersFile = ~/.ssh/allowed_signers

[tag]
    forceSignAnnotated = true

[pull]
    rebase = true

[init]
    defaultBranch = main

[interactive]
    diffFilter = "delta --color-only --features=interactive"

# Git mergetool
[merge]
    tool = opendiff
    conflictstyle = zdiff3        # like diff3 but elides lines common to both sides

[rebase]
    autostash = true              # Stash/unstash dirty worktree around rebase
    autosquash = true             # Auto-reorder fixup!/squash! commits

[push]
    autoSetupRemote = true        # First push sets upstream automatically

[commit]
    verbose = true                # Show the diff in the commit message editor

[diff]
    external = difft              # Syntax-aware diffs for `git diff`
    algorithm = histogram         # Better hunk boundaries for internal diffs

[diff "bin"]
    # Use `hexdump` to diff binary files
    textconv = hexdump -v -C

[rerere]
    enabled = true              # Reuse recorded resolution

[transfer]
    fsckobjects = true          # Security check

[maintenance]
    auto = true                 # Background optimization

[column]
    ui = auto                   # Better column display

[branch]
    sort = -committerdate       # Sort branches by recent activity

[delta]
    features = decorations
    navigate = true
    light = false
    # side-by-side = true
    line-numbers = true
    minus-style                   = bold red
    minus-non-emph-style          = bold red
    minus-emph-style              = bold reverse red
    minus-empty-line-marker-style = normal "#3f0001"
    plus-style                    = bold green
    plus-non-emph-style           = bold green
    plus-emph-style               = bold reverse green

[delta "interactive"]
    keep-plus-minus-markers = false

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul
